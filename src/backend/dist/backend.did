type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type TransformationOutput = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type TransformationInput = 
 record {
   context: blob;
   response: HttpRequestResult;
 };
type Timestamp = int;
type TelegramTestResult = 
 variant {
   err: text;
   ok;
 };
type TelegramSettingsView = 
 record {
   botToken: text;
   chatId: text;
   configured: bool;
 };
type TelegramSettings = 
 record {
   botToken: text;
   chatId: text;
 };
type ShopInput = 
 record {
   active: bool;
   description: text;
   name: text;
   sortOrder: nat;
 };
type Shop = 
 record {
   active: bool;
   description: text;
   id: Id;
   name: text;
   sortOrder: nat;
 };
type Result__1 = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type Result_1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 variant {
   err: PlaceOrderError;
   ok: text;
 };
type ProductInput = 
 record {
   active: bool;
   description: text;
   name: text;
   priceLei: nat;
   shopId: Id;
   unit: text;
 };
type Product = 
 record {
   active: bool;
   description: text;
   id: Id;
   name: text;
   priceLei: nat;
   shopId: Id;
   unit: text;
 };
type PlaceOrderInput = 
 record {
   address: text;
   customerName: text;
   lines: vec OrderLineInput;
   localityId: Id;
   notes: text;
   phone: text;
 };
type PlaceOrderError = 
 variant {
   emptyCart;
   invalidInput: text;
   invalidQuantity;
   telegramNotConfigured;
   unknownLocality: Id;
   unknownProduct: Id;
 };
type OrderStatus = 
 variant {
   anulata;
   confirmata;
   inLivrare;
   livrata;
   noua;
 };
type OrderLineInput = 
 record {
   productId: Id;
   quantity: nat;
 };
type OrderLine = 
 record {
   productId: Id;
   productName: text;
   quantity: nat;
   shopName: text;
   unitPriceLei: nat;
 };
type Order = 
 record {
   address: text;
   createdAt: Timestamp;
   customerName: text;
   deliveryPriceLei: nat;
   id: Id;
   itemsTotalLei: nat;
   lines: vec OrderLine;
   localityId: Id;
   localityName: text;
   notes: text;
   orderNumber: text;
   phone: text;
   status: OrderStatus;
   telegramSent: bool;
   totalLei: nat;
 };
type LocalityInput = 
 record {
   active: bool;
   deliveryPriceLei: nat;
   name: text;
 };
type Locality = 
 record {
   active: bool;
   deliveryPriceLei: nat;
   id: Id;
   name: text;
 };
type Id = nat;
type HttpRequestResult = 
 record {
   body: blob;
   headers: vec HttpHeader;
   status: nat;
 };
type HttpHeader = 
 record {
   name: text;
   value: text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result_1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  createLocality: (input: LocalityInput) -> (Locality);
  createProduct: (input: ProductInput) -> (Product);
  createShop: (input: ShopInput) -> (Shop);
  deleteLocality: (id: Id) -> (bool);
  deleteProduct: (id: Id) -> (bool);
  deleteShop: (id: Id) -> (bool);
  execute: (qJson: text) -> (Result__1) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getOrder: (id: Id) -> (opt Order) query;
  getTelegramSettings: () -> (TelegramSettingsView) query;
  isCallerAdmin: () -> (bool) query;
  listActiveLocalities: () -> (vec Locality) query;
  listActiveProducts: (shopId: Id) -> (vec Product) query;
  listActiveShops: () -> (vec Shop) query;
  listAllLocalities: () -> (vec Locality) query;
  listAllProducts: (shopId: Id) -> (vec Product) query;
  listAllShops: () -> (vec Shop) query;
  listOrders: () -> (vec Order) query;
  placeOrder: (input: PlaceOrderInput) -> (Result);
  resendTelegramNotification: (id: Id) -> (TelegramTestResult);
  saveTelegramSettings: (settings: TelegramSettings) ->
   (TelegramSettingsView);
  schema: () -> (text) query;
  setOrderStatus: (id: Id, status: OrderStatus) -> (opt Order);
  testTelegramSettings: () -> (TelegramTestResult);
  transform: (input: TransformationInput) -> (TransformationOutput) query;
  updateLocality: (id: Id, input: LocalityInput) -> (opt Locality);
  updateProduct: (id: Id, input: ProductInput) -> (opt Product);
  updateShop: (id: Id, input: ShopInput) -> (opt Shop);
  upsertLocalities: (inputs: vec LocalityInput) -> (vec Locality);
}
